{
  "name": "react-code-locator",
  "version": "0.4.7",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/runtime.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dbckdgjs369/web-element-code-locator.git"
  },
  "homepage": "https://github.com/dbckdgjs369/web-element-code-locator#readme",
  "bugs": {
    "url": "https://github.com/dbckdgjs369/web-element-code-locator/issues"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:loaders",
    "build:lib": "tsup",
    "build:loaders": "node scripts/build-loaders.cjs",
    "deploy": "npm run build && npm pack --dry-run --cache .npm-cache && npm publish --access public --cache .npm-cache --otp=$npm_config_otp",
    "release:patch": "npm version patch && npm run build && npm publish --access public --otp=$npm_config_otp",
    "release:minor": "npm version minor && npm run build && npm publish --access public --otp=$npm_config_otp",
    "release:major": "npm version major && npm run build && npm publish --access public --otp=$npm_config_otp",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:transform && npm run test:runtime",
    "test:transform": "esbuild test/transform.spec.mts --bundle --platform=node --format=esm --outfile=node_modules/.cache/rcl-transform-spec.mjs --log-level=error && node node_modules/.cache/rcl-transform-spec.mjs",
    "test:runtime": "esbuild test/runtime.spec.mts --bundle --platform=node --format=esm --outfile=node_modules/.cache/rcl-runtime-spec.mjs --log-level=error && node node_modules/.cache/rcl-runtime-spec.mjs"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@types/estree": "^1.0.8",
    "@types/node": "^22.13.10",
    "estree-walker": "^3.0.3",
    "magic-string": "^0.30.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "unplugin": "^3.0.0",
    "vite": "^5.4.14",
    "webpack-virtual-modules": "^0.6.2"
  }
}
