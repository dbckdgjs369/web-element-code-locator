{
  "name": "react-code-locator",
  "version": "1.0.2",
  "type": "module",
  "description": "Jump from a rendered element to its source, without re-parsing your code",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/runtime.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "require": "./dist/runtime.cjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js",
      "require": "./dist/jsx-runtime.cjs"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js",
      "require": "./dist/jsx-dev-runtime.cjs"
    },
    "./babel": {
      "types": "./dist/babel/plugin.d.ts",
      "import": "./dist/babel/plugin.js",
      "require": "./dist/babel/plugin.cjs"
    },
    "./wrap": {
      "types": "./dist/wrap.d.ts",
      "import": "./dist/wrap.js",
      "require": "./dist/wrap.cjs"
    },
    "./next": {
      "types": "./dist/integrations/next.d.ts",
      "import": "./dist/integrations/next.js",
      "require": "./dist/integrations/next.cjs"
    },
    "./webpack": {
      "types": "./dist/integrations/webpack.d.ts",
      "import": "./dist/integrations/webpack.js",
      "require": "./dist/integrations/webpack.cjs"
    },
    "./rspack": {
      "types": "./dist/integrations/webpack.d.ts",
      "import": "./dist/integrations/webpack.js",
      "require": "./dist/integrations/webpack.cjs"
    },
    "./rollup": {
      "types": "./dist/integrations/rollup.d.ts",
      "import": "./dist/integrations/rollup.js",
      "require": "./dist/integrations/rollup.cjs"
    },
    "./esbuild": {
      "types": "./dist/integrations/esbuild.d.ts",
      "import": "./dist/integrations/esbuild.js",
      "require": "./dist/integrations/esbuild.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dbckdgjs369/web-element-code-locator.git"
  },
  "homepage": "https://github.com/dbckdgjs369/web-element-code-locator#readme",
  "bugs": {
    "url": "https://github.com/dbckdgjs369/web-element-code-locator/issues"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "deploy": "npm run build && npm pack --dry-run --cache .npm-cache && npm publish --access public --cache .npm-cache --otp=$npm_config_otp",
    "release:patch": "npm version patch && npm run build && npm publish --access public --otp=$npm_config_otp",
    "release:minor": "npm version minor && npm run build && npm publish --access public --otp=$npm_config_otp",
    "release:major": "npm version major && npm run build && npm publish --access public --otp=$npm_config_otp"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "vite": "^5.4.14"
  }
}
